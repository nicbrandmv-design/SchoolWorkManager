# Postgres connection string. For local dev, either run Postgres yourself
# (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`) or
# point this at the same database Vercel provisions for your deployment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolwork"

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# claude-opus-5 (best quality) / claude-sonnet-5 (cheaper, still strong) / claude-haiku-4-5 (fastest/cheapest)
ANTHROPIC_MODEL="claude-opus-5"

# Only needed in production (Vercel sets this automatically once you attach a
# Blob store to the project). Leave unset locally — uploads fall back to disk.
BLOB_READ_WRITE_TOKEN=""
